{
  "appId": "com.mekatron.app",
  "appName": "Mekatron",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#1E1F21",
      "launchAutoHide": true,
      "showSpinner": false
    }
  }
}
